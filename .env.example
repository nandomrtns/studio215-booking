# Copie para .env e preencha. Nunca commitar o .env de verdade.

NODE_ENV=development
PORT=3000

# Postgres — no Railway isso é gerado automaticamente quando você adiciona o
# plugin de Postgres ao projeto (variável DATABASE_URL já vem pronta).
DATABASE_URL=postgres://usuario:senha@localhost:5432/studio215_booking

# Origem permitida pro CORS — o site publicado.
ALLOWED_ORIGIN=https://www.studio215poa.com.br

# URL pública deste serviço — usada pra montar o notification_url dos
# pagamentos MP. Só precisa mudar se o domínio do backend mudar.
PUBLIC_BASE_URL=https://studio215-booking-production.up.railway.app

# --- A partir da Fase 2+, ainda não usados nesta fase ---

# Mesma URL secreta já usada em site/.github (repo studio215-site), agora também
# aqui pro booking-service buscar o calendário do Airbnb diretamente.
AIRBNB_ICS_URL=

# Credenciais do Mercado Pago (Checkout Transparente). Comece com as de TESTE
# (prefixo TEST-, geradas no painel de desenvolvedores do MP em "Credenciais
# de teste") — só troca pras de produção depois de validar o fluxo completo
# em sandbox.
MP_ACCESS_TOKEN=
MP_PUBLIC_KEY=
MP_WEBHOOK_SECRET=

# Token de acesso ao .ics de saída (GET /api/ics/studio215.ics?token=...) —
# é o que o Airbnb usa pra importar nosso calendário. Gerar com
# `openssl rand -hex 24`. Sem ela definida, a rota nem é registrada.
CALENDAR_FEED_TOKEN=

# Login do painel admin (senha única, sem tabela de usuários).
ADMIN_PASSWORD_HASH=
ADMIN_JWT_SECRET=

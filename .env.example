# Copie para .env e preencha. Nunca commitar o .env de verdade.

NODE_ENV=development
PORT=3000

# Postgres — no Railway isso é gerado automaticamente quando você adiciona o
# plugin de Postgres ao projeto (variável DATABASE_URL já vem pronta).
DATABASE_URL=postgres://usuario:senha@localhost:5432/studio215_booking

# Origem permitida pro CORS — o site publicado.
ALLOWED_ORIGIN=https://www.studio215poa.com.br

# --- A partir da Fase 2+, ainda não usados nesta fase ---

# Mesma URL secreta já usada em site/.github (repo studio215-site), agora também
# aqui pro booking-service buscar o calendário do Airbnb diretamente.
AIRBNB_ICS_URL=

# Credenciais do Mercado Pago (Checkout Transparente).
MP_ACCESS_TOKEN=
MP_PUBLIC_KEY=
MP_WEBHOOK_SECRET=

# Token de acesso ao .ics de saída (GET /api/ics/studio215.ics?token=...).
CALENDAR_FEED_TOKEN=

# Login do painel admin (senha única, sem tabela de usuários).
ADMIN_PASSWORD_HASH=
ADMIN_JWT_SECRET=
